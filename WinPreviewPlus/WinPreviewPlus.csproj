<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinPreviewPlus</RootNamespace>
    <AssemblyName>WinPreviewPlus</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>WinPreviewPlus.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>WinPreviewPlus</Product>
    <Company>WinPreviewPlus</Company>
    <AssemblyTitle>WinPreviewPlus</AssemblyTitle>
    <Version>1.1.0</Version>
    <!-- PDB содержат пути сборки (Users\…) — в Release не пишем -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpShell" Version="2.7.2" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <!-- WebView2Loader рядом с DLL (prevhost x64) -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <PropertyGroup>
      <_Wv2Loader>$([System.IO.Path]::Combine('$(NuGetPackageRoot)','microsoft.web.webview2','1.0.2903.40','runtimes','win-x64','native','WebView2Loader.dll'))</_Wv2Loader>
    </PropertyGroup>
    <Copy SourceFiles="$(_Wv2Loader)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(_Wv2Loader)')" />
  </Target>
</Project>
